# Copie para .env.local e ajuste conforme necessário

# Ativa a página de manutenção em todo o site (true | false)
# Use true apenas quando quiser exibir a página de manutenção.
NEXT_PUBLIC_MAINTENANCE_MODE=false

# Formulário de contato (quando reativado)
# NEXT_PUBLIC_FORM=

# Página de orçamento (/orcamento/swordfish-brasil-001)
# QUOTE_DISABLED=true → retorna 404 (desativa a rota)
QUOTE_DISABLED=false
# Senha e token de sessão (não usar NEXT_PUBLIC_)
QUOTE_PASSWORD=
QUOTE_SESSION=
